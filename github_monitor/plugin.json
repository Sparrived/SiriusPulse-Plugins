{
  "name": "github_monitor",
  "display_name": "GitHub Monitor",
  "description": "完整监控 GitHub Issue、PR、Release、Comment 和 Push 动态，支持 Poll、Webhook、截图、事件聚合和人格化通知。",
  "version": "1.1.0",
  "author": "Sparrived",
  "min_framework_version": "1.3.0",
  "permissions": {
    "hidden_from_intent": true,
    "rate_limit": {
      "calls_per_minute": 20,
      "calls_per_hour": 300
    }
  },
  "dependencies": [
    "aiohttp>=3.9.0",
    "httpx>=0.24.0",
    "playwright>=1.57.0"
  ],
  "resources": []
}
